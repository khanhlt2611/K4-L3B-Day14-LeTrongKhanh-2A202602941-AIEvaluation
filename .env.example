# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, choose one provider, and replace its placeholder key.
LLM_PROVIDER=openai

# OpenAI configuration (LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Gemini configuration (LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
